<Window x:Class="OODProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OODProject"
        mc:Ignorable="d"
        Title="Character Selection"
        Height="680"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#2E2E2E"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- Theme Brushes -->
        <SolidColorBrush x:Key="RedAccent" Color="#8B0000"/>
        <SolidColorBrush x:Key="DarkPanel" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="LightText" Color="#DDDDDD"/>

        <!-- Header Style -->
        <Style x:Key="HeaderLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#B22222"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANEL ================= -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Background="{StaticResource DarkPanel}"
                CornerRadius="10"
                Padding="15"
                Margin="10"
                BorderBrush="{StaticResource RedAccent}"
                BorderThickness="2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Characters Header -->
                <Label Content="Characters"
                       Style="{StaticResource HeaderLabelStyle}"
                       Margin="0,0,0,10"/>

                <!-- Character List -->
                <ListBox Name="CharLbx"
                         Grid.Row="1"
                         Background="#2E2E2E"
                         Foreground="{StaticResource LightText}"
                         BorderBrush="{StaticResource RedAccent}"
                         BorderThickness="1"
                         d:ItemsSource="{d:SampleData ItemCount=5}"
                         SelectionChanged="CharLbx_SelectionChanged"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" 
            Orientation="Horizontal" 
            Margin="0,15,0,0"
            HorizontalAlignment="Stretch">

                    <Button x:Name="SelectBtn"
            Height="45"
            Width="150"
            Content="Select Character"
            Click="SelectBtn_Click"
            Background="#2E2E2E"
            Foreground="#B22222"
            BorderBrush="{StaticResource RedAccent}"
            BorderThickness="2"
            FontWeight="Bold"
            FontFamily="Georgia"
            Margin="0,0,5,0"/>

                    <Button x:Name="DeleteBtn"
            Height="45"
            Width="60"
            Content="🗑"
            Click="DeleteBtn_Click"
            Background="#2E2E2E"
            Foreground="#B22222"
            BorderBrush="{StaticResource RedAccent}"
            BorderThickness="2"
            FontSize="16"
            Margin="0,0,5,0"/>

                <Button x:Name="RefreshBtn"
                    Height="45"
                    Width="46"
                    FontSize="20"
                    Content="⟳"
                    Click="RefreshBtn_Click"
                    Background="#2E2E2E"
                    Foreground="#B22222"
                    BorderBrush="{StaticResource RedAccent}"
                    BorderThickness="2"
                    FontWeight="Bold"
                    FontFamily="Georgia"/>
                <Button x:Name="EditDescBtn"
                    Height="45"
                    Width="46"
                    Content="✎"
                    Click="EditDescBtn_Click"
                    Background="#2E2E2E"
                    Foreground="#B22222"
                    BorderBrush="{StaticResource RedAccent}"
                    BorderThickness="2"
                    Margin="5,0,5,0"/>
                <Button x:Name="ExportPdfBtn"
                    Height="45"
                    Width="45"
                    Content="📄"
                    Click="ExportPdfBtn_Click"
                    Background="#2E2E2E"
                    Foreground="#B22222"
                    BorderBrush="{StaticResource RedAccent}"
                    BorderThickness="2"
                    Margin="0,0,5,0"/>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ================= RIGHT PANEL ================= -->
        <Border Grid.Column="1"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{StaticResource DarkPanel}"
                CornerRadius="10"
                Padding="15"
                Margin="10"
                BorderBrush="{StaticResource RedAccent}"
                BorderThickness="2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Description Header -->
                <Label Content="Description"
                       Style="{StaticResource HeaderLabelStyle}"
                       Margin="0,0,0,10"/>

                <!-- Description Box -->
                <TextBlock Name="CharTbx"
                           Grid.Row="1"
                           Background="#2E2E2E"
                           Foreground="{StaticResource LightText}"
                           Padding="10"
                           TextWrapping="Wrap"/>

                <!-- Add Button -->
                <Button x:Name="CreateCharBtn" Grid.Row="1"
                        Width="60"
                        Height="60"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="20"
                        FontSize="28"
                        Content="+" Click="CreateCharBtn_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="#8B0000"/>
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextElement.Foreground="White"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>
        </Border>

    </Grid>
</Window>