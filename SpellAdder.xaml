<Window x:Class="OODProject.SpellAdder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OODProject"
        mc:Ignorable="d"
        Title="SpellAdder" Height="400" Width="450" Background="#2E2E2E" Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        
>
    <Window.Resources>
        <SolidColorBrush x:Key="RedAccent" Color="#8B0000"/>
        <SolidColorBrush x:Key="DarkPanel" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="LightText" Color="#DDDDDD"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">
            
            <TextBlock x:Name="CharNameTxt"
                       Foreground="#DDDDDD"
                       FontSize="18"
                       VerticalAlignment="Center"/>

            <TextBlock Text="Spell Level: "
                       Foreground="#B22222"
                       FontWeight="Bold"
                       FontSize="18"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="SpellLevelCbx"
                      Width="60"
                      VerticalAlignment="Center"
                      SelectionChanged="SpellLevelCbx_SelectionChanged">
                <ComboBoxItem Content="All Spells"></ComboBoxItem>
                <ComboBoxItem Content="Cantrip"/>
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="6"/>
                <ComboBoxItem Content="7"/>
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="9"/>
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource DarkPanel}"
                BorderBrush="{StaticResource RedAccent}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Available Spells"
                           Foreground="#B22222"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,0,0,10"/>
                <ListBox x:Name="AvailableSpellsLbx"
                         Grid.Row="1"
                         Background="#2E2E2E"
                         Foreground="{StaticResource LightText}"
                         BorderBrush="{StaticResource RedAccent}"
                         BorderThickness="1"/>
            </Grid>
        </Border>

        <!-- Middle buttons -->
        <StackPanel Grid.Row="1" Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="10,0">
            <Button Content="→"
                    FontSize="10"
                    Width="40"
                    Height="40"
                    Margin="0,5"
                    Background="#8B0000"
                    Foreground="White"
                    BorderThickness="0"
                    Click="AddSpellBtn_Click"/>
            <Button Content="←"
                    FontSize="10"
                    Width="40"
                    Height="40"
                    Margin="0,5"
                    Background="#3A3A3A"
                    Foreground="#B22222"
                    BorderBrush="#8B0000"
                    BorderThickness="2"
                    Click="RemoveSpellBtn_Click"/>
        </StackPanel>

        <!-- Right panel - Added Spells -->
        <Border Grid.Row="1" Grid.Column="2"
                Background="{StaticResource DarkPanel}"
                BorderBrush="{StaticResource RedAccent}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Added Spells"
                           Foreground="#B22222"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,0,0,10"/>
                <ListBox x:Name="AddedSpellsLbx"
                         Grid.Row="1"
                         Background="#2E2E2E"
                         Foreground="{StaticResource LightText}"
                         BorderBrush="{StaticResource RedAccent}"
                         BorderThickness="1"/>
                
            </Grid>
        </Border>

        <!-- Save Button -->
        <Button Grid.Row="2" Grid.Column="2"
                x:Name="SaveSpellsBtn"
                Content="Save Spells"
                Height="40"
                Margin="0,15,0,0"
                Background="#8B0000"
                Foreground="White"
                FontWeight="Bold"
                BorderThickness="0"
                Click="SaveSpellsBtn_Click"/>

    </Grid>
</Window>
