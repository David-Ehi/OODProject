<Window x:Class="OODProject.CreateCharWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OODProject"
        mc:Ignorable="d"
        Title="Create Character"
        Height="680"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        
        Background="#2E2E2E"
        Loaded="Window_Loaded">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#3A3A3A"
                BorderBrush="#8B0000"
                BorderThickness="2"
                CornerRadius="8"
                Padding="10">

            <StackPanel>

                <TextBlock Text="Choose Class"
                           FontSize="18"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="#B22222"
                           Margin="0,0,0,10"/>

                <ListBox x:Name="ClassLbx"
                         SelectionChanged="ClassLbx_SelectionChanged"
                         Background="#2E2E2E"
                         Foreground="#DDDDDD"
                         BorderBrush="#8B0000"
                         Height="auto">
                    


                </ListBox>

            </StackPanel>

        </Border>

        <Border Grid.Column="1"
                Margin="15,0,0,0"
                Background="#3A3A3A"
                BorderBrush="#8B0000"
                BorderThickness="2"
                CornerRadius="8"
                Padding="10">

            <Frame x:Name="ClassFrame"
                   NavigationUIVisibility="Hidden"/>

        </Border>

    </Grid>
</Window>