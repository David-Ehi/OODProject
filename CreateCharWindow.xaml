<Window x:Class="OODProject.CreateCharWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OODProject"
        mc:Ignorable="d"
        Title="CreateCharWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <ListBox x:Name="ClassLbx"  HorizontalAlignment="Left" Height="181" Margin="31,54,0,0" VerticalAlignment="Top" Width="108" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="ClassLbx_SelectionChanged"/>
        <ListBox x:Name="SubclassLbx" HorizontalAlignment="Left" Height="181" Margin="144,54,0,0" VerticalAlignment="Top" Width="110" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <TextBlock x:Name="HitDieTblk" HorizontalAlignment="Left" Height="56" Margin="31,255,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="108"/>
        <TextBlock x:Name="ProfDesc" HorizontalAlignment="Left" Height="75" Margin="307,54,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="215"/>
        <TextBlock x:Name="AbilityScoreProfTxBlk" HorizontalAlignment="Left" Height="91" Margin="307,144,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="135"/>
    </Grid>
</Window>
