<Window x:Class="OODProject.CharWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OODProject"
        mc:Ignorable="d"
        Title="Character Sheet"
        Height="680"
        Width="1100"
        Background="#2E2E2E"
        Loaded="Window_Loaded" MouseDown="Window_MouseDown">

    <Window.Resources>

        <!-- Red Theme Brushes -->
        <SolidColorBrush x:Key="RedAccent" Color="#8B0000"/>
        <SolidColorBrush x:Key="DarkPanel" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="LightText" Color="#DDDDDD"/>

        <!-- Header Style -->
        <Style x:Key="HeaderLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#B22222"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*" x:Name="SpellColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="4"
                BorderBrush="{StaticResource RedAccent}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,20"
                Background="#2E2E2E">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" x:Name="SpellNameColumn"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CharNameLabel"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#B22222"
                       FontSize="20"
                       FontWeight="Bold"
                       Text="Charater Name"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Georgia"/>

                <Label Name="CharSpellLabel"
                       Content="Spells"
                       Grid.Column="2"
                       Style="{StaticResource HeaderLabelStyle}"/>

                <Label Name="CharAbilityLabel"
                       Content="Abilities"
                       Grid.Column="1"
                       Style="{StaticResource HeaderLabelStyle}"/>

                <Label Content="Extra Notes"
                       Grid.Column="3"
                       Style="{StaticResource HeaderLabelStyle}"/>
            </Grid>
        </Border>

        <!-- ================= STATS CARD ================= -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource DarkPanel}"
                CornerRadius="10"
                Padding="20"
                Margin="10"
                BorderBrush="{StaticResource RedAccent}"
                BorderThickness="2">

            <StackPanel>

                <TextBlock Text="Health"
                           FontSize="18"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="#B22222"
                           Margin="0,0,0,15"/>

                <StackPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="HP:" FontWeight="Bold" Foreground="{StaticResource LightText}"/>
                        <TextBox Name="HpTxBx"
                             Width="50"
                             Margin="5,0"
                             Background="#2E2E2E"
                             Foreground="{StaticResource LightText}"
                             BorderBrush="{StaticResource RedAccent}"
                             Padding="5"
                             TextChanged="HpTxBx_TextChanged"/>
                        <Label Content="/" FontWeight="Bold" Foreground="{StaticResource LightText}"/>
                        <Label Name="MaxHpLbl" FontWeight="Bold" Foreground="{StaticResource LightText}"/>
                    </StackPanel>
                    <ProgressBar x:Name="HpBar"
                         Height="15"
                         Minimum="0"
                         Maximum="100"
                         Value="100"
                         Foreground="#228B22"
                         Background="#2E2E2E"
                         BorderBrush="{StaticResource RedAccent}"
                         Margin="0,5,0,0"/>
                </StackPanel>

                <Separator Margin="0,20" Background="#555"/>

                <UniformGrid Rows="2" Columns="3" Margin="0,15,0,0">

                    <TextBlock Text="Armor Class"
               Foreground="{StaticResource LightText}"
               HorizontalAlignment="Center"
               FontWeight="Bold"/>
                    <TextBlock Text="Initiative"
               Foreground="{StaticResource LightText}"
               HorizontalAlignment="Center"
               FontWeight="Bold"/>
                    <TextBlock Text="Prof Bonus"
               Foreground="{StaticResource LightText}"
               HorizontalAlignment="Center"
               FontWeight="Bold"/>

                    <TextBlock x:Name="AcTxbl"
               Foreground="#B22222"
               HorizontalAlignment="Center"
               FontSize="18"
               FontWeight="Bold"/>
                    <TextBlock x:Name="InitiativeTxbl"
               Foreground="#B22222"
               HorizontalAlignment="Center"
               FontSize="18"
               FontWeight="Bold"/>
                    <TextBlock x:Name="ProfBonusTxbl"
               Foreground="#B22222"
               HorizontalAlignment="Center"
               FontSize="18"
               FontWeight="Bold"/>

                </UniformGrid>
                <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <TextBlock Text="Attacks"
                           FontSize="18"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="#B22222"
                           Margin="0,20,0,10"/>
                    <Button x:Name="AddAttackBtn"
                            Height="30"
                            Width="70"
                            Margin="50,0"
                            Background="#2E2E2E"
                            BorderBrush="{StaticResource RedAccent}"
                            Content="+"/>
                </StackPanel>

                    <ListBox Name="AttacksLbBx"
                         Height="160"
                         Background="#2E2E2E"
                         Foreground="{StaticResource LightText}"
                         BorderBrush="{StaticResource RedAccent}"
                         BorderThickness="1"
                         d:ItemsSource="{d:SampleData ItemCount=3}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ================= ABILITIES CARD ================= -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{StaticResource DarkPanel}"
                CornerRadius="10"
                Padding="15"
                Margin="10"
                BorderBrush="{StaticResource RedAccent}"
                BorderThickness="2">

            <StackPanel>
                <TextBlock Text="Abilities"
                           FontSize="18"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="#B22222"
                           Margin="0,0,0,10"/>

                <ListBox Name="AbilitiesLbBx"
                         Height="195"
                         Background="#2E2E2E"
                         Foreground="{StaticResource LightText}"
                         BorderBrush="{StaticResource RedAccent}"
                         BorderThickness="1"
                         d:ItemsSource="{d:SampleData ItemCount=6}"/>
                <TextBlock Text="Skills"
                           FontSize="18"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="#B22222"
                           Margin="0,10,0,10"/>

                <ListBox Name="SkillsLbBx"
                         Height="170"
                         Background="#2E2E2E"
                         Foreground="{StaticResource LightText}"
                         BorderBrush="{StaticResource RedAccent}"
                         BorderThickness="1"
                         d:ItemsSource="{d:SampleData ItemCount=5}"/>
            </StackPanel>
        </Border>

        <!-- ================= DICE CARD ================= -->
        <Border Grid.Row="1"
                Grid.Column="3"
                Background="#1E1E1E"
                CornerRadius="10"
                Padding="20"
                Margin="10"
                BorderBrush="{StaticResource RedAccent}"
                BorderThickness="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="Roll the Dice"
                           Foreground="#B22222"
                           FontSize="18"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <UniformGrid Rows="3" Columns="2" HorizontalAlignment="Center">

                    <Button x:Name="D20Btn"
                            Content="D20"
                            Margin="8"
                            Width="80"
                            Height="80"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#B22222"
                            Background="#2E2E2E"
                            BorderBrush="{StaticResource RedAccent}"
                            BorderThickness="2"
                            Click="D20Btn_Click"/>

                    <Button x:Name="D12Btn"
                            Content="D12"
                            Margin="8"
                            Width="80"
                            Height="80"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#B22222"
                            Background="#2E2E2E"
                            BorderBrush="{StaticResource RedAccent}"
                            BorderThickness="2"
                            Click="D12Btn_Click"/>

                    <Button x:Name="D10Btn"
                            Content="D10"
                            Margin="8"
                            Width="80"
                            Height="80"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#B22222"
                            Background="#2E2E2E"
                            BorderBrush="{StaticResource RedAccent}"
                            BorderThickness="2"
                            Click="D10Btn_Click"/>

                    <Button x:Name="D8Btn"
                            Content="D8"
                            Margin="8"
                            Width="80"
                            Height="80"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#B22222"
                            Background="#2E2E2E"
                            BorderBrush="{StaticResource RedAccent}"
                            BorderThickness="2"
                            Click="D8Btn_Click"/>

                    <Button x:Name="D6Btn"
                            Content="D6"
                            Margin="8"
                            Width="80"
                            Height="80"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#B22222"
                            Background="#2E2E2E"
                            BorderBrush="{StaticResource RedAccent}"
                            BorderThickness="2"
                            Click="D6Btn_Click"/>

                    <Button x:Name="D4Btn"
                            Content="D4"
                            Margin="8"
                            Width="80"
                            Height="80"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#B22222"
                            Background="#2E2E2E"
                            BorderBrush="{StaticResource RedAccent}"
                            BorderThickness="2"
                            Click="D4Btn_Click"/>

                </UniformGrid>

            </StackPanel>
        </Border>

        <!-- ======Spell Card====== -->

        <Border Grid.Row="2"
        Grid.Column="2"
        Background="{StaticResource DarkPanel}"
        CornerRadius="10"
        Padding="15"
        Margin="10"
        BorderBrush="{StaticResource RedAccent}"
        BorderThickness="2">

            <StackPanel>
                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock 
                   Text="Spells Known"
                   FontSize="18"
                   FontWeight="Bold"
                   FontFamily="Georgia"
                   Foreground="#B22222"
                    VerticalAlignment="Center"
                   Margin="0,0,20,0"/>

                        <Button x:Name="RefreshSpellBtn"
                    Height="45"
                    Width="60"
                    FontSize="20"
                    Content="⟳"
                    Click="RefreshSpellBtn_Click"
                    Background="#2E2E2E"
                    Foreground="#B22222"
                    BorderBrush="{StaticResource RedAccent}"
                    BorderThickness="2"
                    FontWeight="Bold"
                    FontFamily="Georgia"/>


                    </StackPanel>

                    <ListBox x:Name="SpellsLbx"
                 Height="165"
                 Background="#2E2E2E"
                 Foreground="{StaticResource LightText}"
                 BorderBrush="{StaticResource RedAccent}"
                 BorderThickness="1"
                 d:ItemsSource="{d:SampleData ItemCount=6}" MouseDoubleClick="SpellsLbx_MouseDoubleClick"/>
                    
                    
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Add Spell"
                           FontSize="18"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="#B22222"
                           VerticalAlignment="Center"/>

                    <Button x:Name="AddSpellBtn"
                        Height="30"
                        Width="70"
                        Margin="40,0,0,0"
                        Background="#2E2E2E"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource RedAccent}"
                        Content="+" Click="AddSpellBtn_Click"/>
                    </StackPanel>

                    <TextBlock Text="Spell Slots"
                       FontSize="18"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="#B22222"
                       Margin="0,10,0,5"/>

                    <Border BorderBrush="{StaticResource RedAccent}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="8">
                        <UniformGrid Columns="3">

                            <TextBlock Text="Level 1" Foreground="{StaticResource LightText}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="Level 2" Foreground="{StaticResource LightText}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="Level 3" Foreground="{StaticResource LightText}" HorizontalAlignment="Center" FontWeight="Bold"/>

                            <TextBlock x:Name="Slot1Txbl" Foreground="#B22222" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="Slot2Txbl" Foreground="#B22222" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="Slot3Txbl" Foreground="#B22222" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>

                            <TextBlock Text="Level 4" Foreground="{StaticResource LightText}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="Level 5" Foreground="{StaticResource LightText}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="Level 6" Foreground="{StaticResource LightText}" HorizontalAlignment="Center" FontWeight="Bold"/>

                            <TextBlock x:Name="Slot4Txbl" Foreground="#B22222" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="Slot5Txbl" Foreground="#B22222" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="Slot6Txbl" Foreground="#B22222" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>

                            <TextBlock Text="Level 7" Foreground="{StaticResource LightText}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="Level 8" Foreground="{StaticResource LightText}" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="Level 9" Foreground="{StaticResource LightText}" HorizontalAlignment="Center" FontWeight="Bold"/>

                            <TextBlock x:Name="Slot7Txbl" Foreground="#B22222" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="Slot8Txbl" Foreground="#B22222" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="Slot9Txbl" Foreground="#B22222" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>

                        </UniformGrid>
                    </Border>

                    <Popup x:Name="SpellDescPopup"
   StaysOpen="False"
   Focusable="True"
   Placement="MousePoint">

                        <Border Background="#3A3A3A"
BorderBrush="#8B0000"
BorderThickness="2"
CornerRadius="8"
Padding="15"
Width="250">

                            <StackPanel>
                                <TextBlock x:Name="PopupSpellNameTxt"
           Foreground="#B22222"
           FontWeight="Bold"
           FontSize="16"
           Margin="0,0,0,5"/>
                                <TextBlock x:Name="PopupSpellDetailTxt"
           Foreground="#DDDDDD"
           TextWrapping="Wrap"/>
                            </StackPanel>

                        </Border>

                    </Popup>

                </StackPanel>


            </StackPanel>
            
        </Border>

    </Grid>
</Window>