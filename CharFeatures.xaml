<Window x:Class="OODProject.CharFeatures"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OODProject"
        mc:Ignorable="d"
        Title="CharFeatures" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <ListBox x:Name="Featurelbx" HorizontalAlignment="Left" Height="272" Margin="38,75,0,0" VerticalAlignment="Top" Width="166" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="Featurelbx_SelectionChanged"/>
        <TextBlock x:Name="FeatureDescTbx" HorizontalAlignment="Left" Height="255" Margin="295,92,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="370"/>

    </Grid>
</Window>
