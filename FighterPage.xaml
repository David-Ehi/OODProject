<Page x:Class="OODProject.FighterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="1000"
      Background="#2E2E2E"
      Title="FighterPage"
      Loaded="Page_Loaded">

    <Grid Margin="25">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
                Margin="10"
                Padding="15"
                Background="#3A3A3A"
                CornerRadius="10"
                BorderBrush="#8B0000"
                BorderThickness="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Fighter Creation"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#B22222"
                               FontFamily="Georgia"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Hit Points"
                               Foreground="#B22222"
                               FontWeight="Bold"/>
                    <TextBox x:Name="HpTbx"
                             Width="80"
                             Margin="0,5,0,15"
                             Background="#2E2E2E"
                             Foreground="#DDDDDD"
                             BorderBrush="#8B0000"/>

                    <TextBlock Text="Hit Die"
                               Foreground="#B22222"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="HitDieTxbl"
                               Foreground="#DDDDDD"
                               Margin="0,5,0,10"/>

                    <TextBlock Text="Saving Throws"
                               Foreground="#B22222"
                               FontWeight="Bold"
                               Margin="0,10,0,5"/>
                    <TextBlock x:Name="SavingThrowsTxt"
                               Foreground="#DDDDDD"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Level"
                               Foreground="#B22222"
                               FontWeight="Bold"/>
                    <ComboBox x:Name="LvlCbx"
                              Width="100"
                              Margin="0,5,0,15"
                              SelectionChanged="LvlCbx_SelectionChanged">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="9"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="11"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="13"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="17"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="19"/>
                        <ComboBoxItem Content="20"/>
                    </ComboBox>

                    <TextBlock Text="Class Features"
                               Foreground="#B22222"
                               FontWeight="Bold"/>
                    <ListBox x:Name="ClassFeaturelbx"
                             Height="120"
                             Margin="0,5,0,10"
                             Background="#2E2E2E"
                             Foreground="#DDDDDD"
                             BorderBrush="#8B0000"
                             BorderThickness="1"/>

                </StackPanel>
            </ScrollViewer>

        </Border>

        <!-- ABILITY SCORES -->
        <Border Grid.Column="1"
                Margin="10"
                Padding="15"
                Background="#3A3A3A"
                CornerRadius="10"
                BorderBrush="#8B0000"
                BorderThickness="2">

            <StackPanel>

                <TextBlock Text="Ability Scores"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#B22222"
                           Margin="0,0,0,15"/>

                <UniformGrid Columns="2" Rows="6">

                    <TextBlock Text="STR" Foreground="#DDDDDD"/>
                    <TextBox x:Name="StrTbx"/>

                    <TextBlock Text="DEX" Foreground="#DDDDDD"/>
                    <TextBox x:Name="DexTbx"/>

                    <TextBlock Text="CON" Foreground="#DDDDDD"/>
                    <TextBox x:Name="ConTbx"/>

                    <TextBlock Text="INT" Foreground="#DDDDDD"/>
                    <TextBox x:Name="IntTbx"/>

                    <TextBlock Text="WIS" Foreground="#DDDDDD"/>
                    <TextBox x:Name="WisTbx"/>

                    <TextBlock Text="CHA" Foreground="#DDDDDD"/>
                    <TextBox x:Name="ChaTbx"/>

                </UniformGrid>

                <TextBlock x:Name="Profbonistxbk"
                           Foreground="#DDDDDD"
                           Margin="0,15,0,5"/>

                <TextBlock Text="Player Name"
                           Foreground="#B22222"
                           FontWeight="Bold"/>
                <TextBox x:Name="playernametbx"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Character Name"
                           Foreground="#B22222"
                           FontWeight="Bold"/>
                <TextBox x:Name="CharacterNametbx"
                         Margin="0,5,0,15"/>

                <Button x:Name="SaveCharacter"
                        Content="Save Character"
                        Click="SaveCharacter_Click"
                        Height="40"
                        Background="#8B0000"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"/>

            </StackPanel>

        </Border>

        <!-- CLASS OPTIONS -->
        <Border Grid.Column="2"
                Margin="10"
                Padding="15"
                Background="#3A3A3A"
                CornerRadius="10"
                BorderBrush="#8B0000"
                BorderThickness="2">

            <StackPanel>

                <TextBlock Text="Subclass"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#B22222"
                           Margin="0,0,0,10"/>

                <ComboBox x:Name="SubclassCbBx"
                          Width="220"
                          Margin="0,0,0,20"/>

                <TextBlock Text="Fighting Style"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#B22222"
                           Margin="0,0,0,10"/>

                <ComboBox x:Name="fightingstylecbobx"
                          Width="220"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="Defense"/>
                    <ComboBoxItem Content="Dueling"/>
                    <ComboBoxItem Content="Great Weapon Fighting"/>
                    <ComboBoxItem Content="Two Weapon Fighting"/>
                </ComboBox>

                <GroupBox Header="Skills (Choose Two)"
                          Foreground="#B22222"
                          BorderBrush="#8B0000"
                          BorderThickness="1">

                    <StackPanel>
                        <CheckBox Content="Acrobatics" x:Name="SkillAcrobatics"/>
                        <CheckBox Content="Animal Handling" x:Name="SkillAnimalHandling"/>
                        <CheckBox Content="Athletics" x:Name="SkillAthletics"/>
                        <CheckBox Content="History" x:Name="SkillHistory"/>
                        <CheckBox Content="Insight" x:Name="SkillInsight"/>
                        <CheckBox Content="Intimidation" x:Name="SkillIntimidation"/>
                        <CheckBox Content="Perception" x:Name="SkillPerception"/>
                        <CheckBox Content="Survival" x:Name="SkillSurvival"/>
                    </StackPanel>

                </GroupBox>

            </StackPanel>

        </Border>

    </Grid>

</Page>