<Page x:Class="OODProject.FighterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OODProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FighterPage" Loaded="Page_Loaded">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- CLASS INFO -->
        <StackPanel Grid.Column="0">

            <TextBlock Text="Fighter Creation"
                       FontSize="22"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="#B22222"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="HitDieTxbl"
                       Foreground="#DDDDDD"
                       Margin="0,5"/>

            <TextBlock Text="Saving Throws"
                       Foreground="#B22222"
                       FontWeight="Bold"
                       Margin="0,10,0,5"/>

            <TextBlock x:Name="SavingThrowsTxt"
                       Foreground="#DDDDDD"
                       TextWrapping="Wrap"/>

            <TextBlock Text="HP"
                       Foreground="#B22222"
                       FontWeight="Bold"
                       Margin="0,20,0,5"/>

            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="HpTbx"
                         Width="60"
                         Background="#3A3A3A"
                         Foreground="#DDDDDD"/>

                <Button Content="Roll HP"
                        Margin="10,0"
                        Click="RollHpBtn_Click"
                        Background="#8B0000"
                        Foreground="White"/>
            </StackPanel>
            <ListBox x:Name="ClassFeaturelbx" Height="123" Width="181" d:ItemsSource="{d:SampleData ItemCount=5}"/>
            <ComboBox x:Name="LvlCbx" Height="32" Width="68" SelectionChanged="LvlCbx_SelectionChanged">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="6"/>
                <ComboBoxItem Content="7"/>
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="9"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="11"/>
                <ComboBoxItem Content="12"/>
                <ComboBoxItem Content="13"/>
                <ComboBoxItem Content="14"/>
                <ComboBoxItem Content="15"/>
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="17"/>
                <ComboBoxItem Content="18"/>
                <ComboBoxItem Content="19"/>
                <ComboBoxItem Content="20"/>
                
            </ComboBox>

        </StackPanel>

        <!-- ABILITY SCORES -->
        <StackPanel Grid.Column="1">

            <TextBlock Text="Ability Scores"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#B22222"
                       Margin="0,0,0,10"/>

            <UniformGrid Columns="2" Rows="6">

                <TextBlock Text="STR" Foreground="#DDDDDD"/>
                <TextBox x:Name="StrTbx"/>

                <TextBlock Text="DEX" Foreground="#DDDDDD"/>
                <TextBox x:Name="DexTbx"/>

                <TextBlock Text="CON" Foreground="#DDDDDD"/>
                <TextBox x:Name="ConTbx"/>

                <TextBlock Text="INT" Foreground="#DDDDDD"/>
                <TextBox x:Name="IntTbx"/>

                <TextBlock Text="WIS" Foreground="#DDDDDD"/>
                <TextBox x:Name="WisTbx"/>

                <TextBlock Text="CHA" Foreground="#DDDDDD"/>
                <TextBox x:Name="ChaTbx"/>

            </UniformGrid>

            <Button Content="Roll Ability Scores"
                    Margin="0,15,0,0"
                    Click="RollStatsBtn_Click"
                    Background="#8B0000"
                    Foreground="White"/>

        </StackPanel>

        <!-- CLASS OPTIONS -->
        <StackPanel Grid.Column="2">

            <TextBlock Text="Subclass"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#B22222"
                       Margin="0,0,0,10"/>

            <ComboBox x:Name="SubclassCbBx"
                      Width="200"
                      Margin="0,0,0,20"/>

            <TextBlock Text="Fighting Style"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#B22222"
                       Margin="0,0,0,10"/>

            <ComboBox x:Name="fightingstylecbobx"
                      Width="200">

                <ComboBoxItem Content="Defense"/>
                <ComboBoxItem Content="Dueling"/>
                <ComboBoxItem Content="Great Weapon Fighting"/>
                <ComboBoxItem Content="Two Weapon Fighting"/>

            </ComboBox>

        </StackPanel>

    </Grid>

</Page>
