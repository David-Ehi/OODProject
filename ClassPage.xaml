<Page x:Class="OODProject.ClassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="1000"
      Background="#2E2E2E"
      Title="FighterPage"
      Loaded="Page_Loaded">

    <Grid Margin="25">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
                Margin="10"
                Padding="15"
                Background="#3A3A3A"
                CornerRadius="10"
                BorderBrush="#8B0000"
                BorderThickness="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock x:Name="ClassTitleTxt"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#B22222"
                       FontFamily="Georgia"
                       Margin="0,0,0,20"/>

                    <TextBlock Text="Hit Points"
                               Foreground="#B22222"
                               FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0, 5, 0, 15">
                        <TextBox x:Name="HpTbx"
                             Width="80"
                             Background="#2E2E2E"
                             Foreground="#DDDDDD"
                             BorderBrush="#8B0000"
                             HorizontalAlignment="Left"/>
                        <Button x:Name="HealthRollBtn"
                            Content="Roll Health"
                            Height="30"
                            Background="#8B0000"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0" 
                            Width="110"
                            Margin="10,0,0,0" Click="HealthRollBtn_Click_1"/>
                    </StackPanel>

                    <TextBlock Text="Hit Die"
                               Foreground="#B22222"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="HitDieTxbl"
                               Foreground="#DDDDDD"
                               Margin="0,5,0,10"/>

                    <TextBlock Text="Saving Throws"
                               Foreground="#B22222"
                               FontWeight="Bold"
                               Margin="0,10,0,5"/>
                    <TextBlock x:Name="SavingThrowsTxt"
                               Foreground="#DDDDDD"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Level"
                               Foreground="#B22222"
                               FontWeight="Bold"/>
                    <ComboBox x:Name="LvlCbx"
                              Width="100"
                              Background="#2E2E2E"
                              HorizontalAlignment="left"
                              Margin="0,5,0,15"
                              SelectionChanged="LvlCbx_SelectionChanged">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="9"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="11"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="13"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="17"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="19"/>
                        <ComboBoxItem Content="20"/>
                    </ComboBox>




                    <TextBlock Text="Class Features"
                               Foreground="#B22222"
                               FontWeight="Bold"/>
                    <ListBox x:Name="ClassFeaturelbx"
                             Height="120"
                             Margin="0,5,0,10"
                             Background="#2E2E2E"
                             Foreground="#DDDDDD"
                             BorderBrush="#8B0000"
                             BorderThickness="1" MouseDoubleClick="ClassFeaturelbx_MouseDoubleClick"/>

                </StackPanel>
            </ScrollViewer>

        </Border>

        <!-- ABILITY SCORES -->
        <Border Grid.Column="2"
                Margin="10"
                Padding="15"
                Background="#3A3A3A"
                CornerRadius="10"
                BorderBrush="#8B0000"
                BorderThickness="2">

            <StackPanel>

                <TextBlock Text="Ability Scores"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#B22222"
                           Margin="0,0,0,15"/>

                <Button x:Name="RollStatsBtn"
                        Content="Roll Stats"
                        Height="30"
                        Width="100"
                        HorizontalAlignment="Right"
                        Background="#8B0000"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="0,0,10,15" Click="RollStatsBtn_Click_1"/>


                <UniformGrid Columns="2" Rows="6">

                    <TextBlock Text="STR" Foreground="#DDDDDD"/>
                    <TextBox x:Name="StrTbx"
                             Width="80"
                             HorizontalAlignment="Right"/>

                    <TextBlock Text="DEX" Foreground="#DDDDDD"/>
                    <TextBox x:Name="DexTbx" Width="80" HorizontalAlignment="Right"/>

                    <TextBlock Text="CON" Foreground="#DDDDDD"/>
                    <TextBox x:Name="ConTbx" Width="80" HorizontalAlignment="Right"/>

                    <TextBlock Text="INT" Foreground="#DDDDDD"/>
                    <TextBox x:Name="IntTbx" Width="80" HorizontalAlignment="Right"/>

                    <TextBlock Text="WIS" Foreground="#DDDDDD"/>
                    <TextBox x:Name="WisTbx" Width="80" HorizontalAlignment="Right"/>

                    <TextBlock Text="CHA" Foreground="#DDDDDD"/>
                    <TextBox x:Name="ChaTbx" Width="80" HorizontalAlignment="Right"/>

                </UniformGrid>

                <TextBlock x:Name="Profbonistxbk"
                           Foreground="#DDDDDD"
                           Margin="0,15,0,5"/>

                <TextBlock Text="Player Name"
                           Foreground="#B22222"
                           FontWeight="Bold"/>
                <TextBox x:Name="playernametbx"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Character Name"
                           Foreground="#B22222"
                           FontWeight="Bold"/>
                <TextBox x:Name="CharacterNametbx"
                         Margin="0,5,0,15"/>

                <Button x:Name="SaveCharacter"
                        Content="Save Character"
                        Click="SaveCharacter_Click"
                        Height="40"
                        Background="#8B0000"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"/>

            </StackPanel>

        </Border>

        <!-- CLASS OPTIONS -->
        <Border Grid.Column="1"
                Margin="10"
                Padding="15"
                Background="#3A3A3A"
                CornerRadius="10"
                BorderBrush="#8B0000"
                BorderThickness="2">

            <StackPanel>

                <StackPanel x:Name="SubclassPanel" Visibility="Collapsed">
                    <TextBlock Text="Subclass"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#B22222"
                           Margin="0,0,0,10"/>

                    <ComboBox x:Name="SubclassCbBx"
                          DisplayMemberPath="name"
                          Width="220"/>
                </StackPanel>

                <StackPanel x:Name="FightingStylePanel" Visibility="Collapsed">

                    <TextBlock Text="Fighting Style"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#B22222"
                       Margin="0,0,0,10"/>

                    <ComboBox x:Name="fightingstylecbobx"
                      Width="220"
                      Margin="0,0,0,20"/>
                </StackPanel>

                <Border BorderBrush="#8B0000"
        BorderThickness="1"
        CornerRadius="5"
        Padding="10"
        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Race"
           Foreground="#B22222"
           FontWeight="Bold"/>
                        <ComboBox x:Name="RaceCbx"
          Width="100"
          Background="#2E2E2E"
          HorizontalAlignment="left"
          Margin="0,5,0,15"
          >


                            <ComboBoxItem Content="Dragonborn"/>
                            <ComboBoxItem Content="Dwarf"/>
                            <ComboBoxItem Content="Elf"/>
                            <ComboBoxItem Content="Gnome"/>
                            <ComboBoxItem Content="Half-Elf"/>
                            <ComboBoxItem Content="Half-Orc"/>
                            <ComboBoxItem Content="Halfling"/>
                            <ComboBoxItem Content="Human"/>
                            <ComboBoxItem Content="Tiefling"/>
                        </ComboBox>
                        <TextBlock Text="Armor Class (AC)"
           Foreground="#B22222"
           FontWeight="Bold"/>
                        <TextBox x:Name="AcTbx"
         Width="80"
         Margin="0,5,0,15"
         Background="#2E2E2E"
         Foreground="#DDDDDD"
         BorderBrush="#8B0000"
         HorizontalAlignment="Left"/>
                        <TextBlock x:Name="SkillsHeaderTxt" 
                   Text="Skills (Choose Two)"
                   Foreground="#B22222"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>
                        <CheckBox Content="Acrobatics" x:Name="SkillAcrobatics" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Animal Handling" x:Name="SkillAnimalHandling" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Athletics" x:Name="SkillAthletics" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Arcana" x:Name="SkillArcana" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Deception" x:Name="SkillDeception" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="History" x:Name="SkillHistory" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Insight" x:Name="SkillInsight" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Intimidation" x:Name="SkillIntimidation" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Investigation" x:Name="SkillInvestigation" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Medicine" x:Name="SkillMedicine" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Nature" x:Name="SkillNature" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Perception" x:Name="SkillPerception" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Performance" x:Name="SkillPerformance" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Persuasion" x:Name="SkillPersuasion" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Religion" x:Name="SkillReligion" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Sleight of Hand" x:Name="SkillSleightOfHand" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Stealth" x:Name="SkillStealth" Foreground="#DDDDDD" Visibility="Collapsed"/>
                        <CheckBox Content="Survival" x:Name="SkillSurvival" Foreground="#DDDDDD" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </StackPanel>

        </Border>


        <Popup x:Name="FeatureDescPopup"
           StaysOpen="False"
           Placement="MousePoint">

            <Border Background="#3A3A3A"
                BorderBrush="#8B0000"
                BorderThickness="2"
                CornerRadius="8"
                Padding="15"
                Width="250">

                <StackPanel>
                    <TextBlock x:Name="PopupNameTxt"
                           Foreground="#B22222"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,0,0,5"/>
                    <TextBlock x:Name="PopupDetailTxt"
                           Foreground="#DDDDDD"
                           TextWrapping="Wrap"/>
                </StackPanel>

            </Border>

        </Popup>

    </Grid>

</Page>